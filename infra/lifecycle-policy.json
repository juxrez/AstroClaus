{
  "rules": [
    {
      "enabled": true,
      "name": "delete-letters-after-90-days",
      "type": "Lifecycle",
      "definition": {
        "actions": {
          "baseBlob": {
            "delete": { "daysAfterCreationGreaterThan": 90 }
          }
        },
        "filters": {
          "blobTypes": [ "blockBlob" ],
          "prefixMatch": [ "letters/" ]
        }
      }
    }
  ]
}
