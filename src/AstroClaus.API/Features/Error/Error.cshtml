@page "/error/{code:int?}"
@model AstroClaus.API.Features.Error.ErrorModel
@{
    // Its own small page instead of _Layout: no diorama and no scripts, so as little as possible
    // can fail while showing it, and the only Astro on screen is the sad one.
    Layout = null;
    var title = T[Model.IsNotFound ? "Lost in the snow" : Model.IsTooManyRequests ? "Too many snowballs!" : "Snowed in!"];
}
<!DOCTYPE html>
<html lang="@(Languages.IsSpanish ? "es" : "en")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@title · Astro Claus</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="error-page">
    <main class="error-card">
        <img class="error-astro" src="~/assets/astro-sad.png" asp-append-version="true"
             alt="@T["Astro looking sad, with snow piled on his head"]" width="32" height="32" />
        <h1 class="title">@title</h1>
        @if (Model.IsNotFound)
        {
            <p class="body-lg">@T["Oops, we couldn't find anything here."]</p>
            <p class="body muted">@T["The snow may have covered it up."]</p>
        }
        else if (Model.IsTooManyRequests)
        {
            <p class="body-lg">@T["Astro can't keep up with so many at once."]</p>
            <p class="body muted">@T["Please wait a few minutes and try again."]</p>
        }
        else
        {
            <p class="body-lg">@T["We're sorry, heavy snow is causing issues in our system. Astro is already digging us out."]</p>
            <p class="body muted">@T["Please try again in a little while."]</p>
        }
        <a class="btn btn-primary" href="~/">@T["Back home"]</a>
    </main>
</body>
</html>
