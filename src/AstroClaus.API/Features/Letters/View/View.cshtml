@page "/letter/{id}"
@model AstroClaus.API.Features.Letters.View.ViewModel
@{
    ViewData["Title"] = Model.Letter is null ? "Letter delivered" : $"A letter from {Model.Letter.From}";
    if (Model.JustSent)
    {
        ViewData["Diorama"] = "delivery";
    }
}

@if (Model.Letter is { } letter)
{
    <section class="page" data-motion="view" data-open-share="@(Model.JustSent ? "true" : "false")">
        @if (Model.JustSent)
        {
            <div class="page-head">
                <span class="badge badge-aurora pixel-tag">DELIVERED</span>
            </div>
        }

        <article class="paper" data-motion="letter-paper">
            <p class="subtitle">Dear Santa,</p>
            <p class="body-lg">@letter.Message</p>

            <h2 class="heading">My wish list</h2>
            <ul class="wish-list">
                @foreach (var wish in letter.Wishes)
                {
                    <li class="wish-read" data-motion="wish-item" data-letter-wish>
                        <p class="body-strong" data-wish-name>@wish.Name</p>
                        @if (Wish.IsWebLink(wish.Link))
                        {
                            <a class="wish-link caption" href="@wish.Link" target="_blank" rel="noopener noreferrer nofollow ugc" data-wish-link>Find it here<span class="visually-hidden">: @wish.Name</span></a>
                        }
                        @if (wish.Images.Count > 0)
                        {
                            <div class="wish-pictures">
                                @foreach (var image in wish.Images)
                                {
                                    @* Opens in the picture modal; without the page script, in a new tab *@
                                    <a href="/letter/@letter.Id/images/@image" target="_blank" rel="noopener" data-picture>
                                        <img src="/letter/@letter.Id/images/@image" alt="Picture for @wish.Name" loading="lazy" />
                                    </a>
                                }
                            </div>
                        }
                    </li>
                }
            </ul>

            <p class="subtitle sign-off">With love, @letter.From</p>
        </article>

        <div class="actions">
            <button type="button" class="btn btn-primary" data-open-modal="share-modal">
                <span class="icon icon-share-link" aria-hidden="true"></span>
                Share or copy link
            </button>
            <a class="btn btn-secondary" href="/write">Write your own letter</a>
        </div>
    </section>

    <partial name="_ShareModal" model="Model.ShareUrl" />

    @* One modal for every picture on the letter; the page script fills it with the picture clicked.
       No buttons: Escape or a click outside closes it. *@
    <dialog class="modal modal-picture" id="picture-modal" aria-labelledby="picture-title">
        <figure>
            <img data-picture-image alt="" />
            <figcaption>
                <span class="body-strong" id="picture-title" data-picture-title></span>
                <a class="caption" target="_blank" rel="noopener noreferrer nofollow ugc" data-picture-link hidden>Find it here</a>
            </figcaption>
        </figure>
    </dialog>
}
else
{
    <section class="page" data-motion="view">
        <h1 class="title">This letter has been delivered</h1>
        <p class="body">Letters stay for 90 days, then Astro carries them to the North Pole for good. This one is already with Santa.</p>
        <a class="btn btn-primary" href="/write">Write a letter</a>
    </section>
}
