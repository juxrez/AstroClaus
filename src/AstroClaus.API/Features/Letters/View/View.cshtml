@page "/letter/{id}"
@model AstroClaus.API.Features.Letters.View.ViewModel
@{
    ViewData["Title"] = Model.Letter is null ? "Letter delivered" : $"A letter from {Model.Letter.From}";
}

@if (Model.Letter is { } letter)
{
    <section class="card" data-motion="view" data-open-share="@(Model.JustSent ? "true" : "false")">
        <div class="page-head">
            <div data-motion="delivery" data-state="@(Model.JustSent ? "delivering" : "resting")">
                <partial name="_Astro" model="@("side")" />
            </div>
            @if (Model.JustSent)
            {
                <span class="badge badge-pine pixel-tag">DELIVERED</span>
            }
        </div>

        <article class="paper" data-motion="letter-paper">
            <p class="subtitle">Dear Santa,</p>
            <p class="body-lg">@letter.Message</p>

            <h2 class="heading">My wish list</h2>
            <ul class="wish-list">
                @foreach (var wish in letter.Wishes)
                {
                    <li class="wish-read" data-motion="wish-item">
                        <p class="body-strong">@wish.Name</p>
                        @if (wish.Images.Count > 0)
                        {
                            <div class="wish-pictures">
                                @foreach (var image in wish.Images)
                                {
                                    <a href="/letter/@letter.Id/images/@image" target="_blank" rel="noopener">
                                        <img src="/letter/@letter.Id/images/@image" alt="Picture for @wish.Name" loading="lazy" />
                                    </a>
                                }
                            </div>
                        }
                    </li>
                }
            </ul>

            <p class="subtitle sign-off">With love, @letter.From</p>
        </article>

        <div class="actions">
            <button type="button" class="btn btn-primary" data-open-modal="share-modal">
                <span class="icon icon-share-link" aria-hidden="true"></span>
                Share or copy link
            </button>
            <a class="btn btn-secondary" href="/write">Write your own letter</a>
        </div>
    </section>

    <partial name="_ShareModal" model="Model.ShareUrl" />
}
else
{
    <section class="card" data-motion="view">
        <partial name="_Astro" model="@("side")" />
        <h1 class="title">This letter has been delivered</h1>
        <p class="body">Letters stay for 90 days, then Astro carries them to the North Pole for good. This one is already with Santa.</p>
        <a class="btn btn-primary" href="/write">Write a letter</a>
    </section>
}
