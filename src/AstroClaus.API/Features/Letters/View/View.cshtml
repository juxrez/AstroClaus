@page "/letter/{id}"
@model AstroClaus.API.Features.Letters.View.ViewModel
@using System.Globalization
@{
    ViewData["Title"] = Model.Letter is null ? "Letter delivered" : $"A letter from {Model.Letter.From}";
    // Just sent: Astro runs off with the letter. Opened by a reader: Astro plays in the snow.
    // On phones he shows in a window above the letter (design/DESIGN.md §2, rule 13).
    if (Model.Letter is not null)
    {
        ViewData["Diorama"] = Model.JustSent ? "delivery" : "play";
        ViewData["SceneWindow"] = true;
    }
}

@if (Model.Letter is { } letter)
{
    var sent = letter.CreatedAt;
    var whatsApp = "https://wa.me/?text=" + Uri.EscapeDataString("I wrote a letter to Santa. Read it here: " + Model.ShareUrl);

    @* data-just-sent: on narrow screens the share section moves above the letter (DESIGN.md §4) *@
    <section class="page letter-page" data-just-sent="@(Model.JustSent ? "true" : "false")">
        <div class="letter-status">
            <span class="badge badge-aurora pixel-tag">
                <span class="icon icon-check" aria-hidden="true"></span>
                DELIVERED
            </span>
            <span class="caption muted">
                Sent @sent.ToString("d MMM yyyy", CultureInfo.InvariantCulture)
                @if (!Model.IsExample)
                {
                    @:· Kept until @sent.AddDays(LetterLimits.RetentionDays).ToString("d MMM yyyy", CultureInfo.InvariantCulture)
                }
            </span>
        </div>

        <article class="paper" aria-label="The letter">
            <div class="letter-address">
                <p class="overline">TO: THE NORTH POLE<br />FROM: @letter.From.ToUpperInvariant()</p>
                @* Decoration only: the status row above says the same in words *@
                <div class="postmark" aria-hidden="true">
                    <span>NORTH POLE</span>
                    <span class="postmark-day">@sent.ToString("d MMM", CultureInfo.InvariantCulture).ToUpperInvariant()</span>
                    <span>@sent.Year</span>
                </div>
            </div>

            <p class="subtitle">Dear Santa,</p>
            <p class="hand">@letter.Message</p>

            <h2 class="heading">My wishes</h2>
            <ol class="wish-cards">
                @for (var i = 0; i < letter.Wishes.Count; i++)
                {
                    var wish = letter.Wishes[i];
                    @* --i staggers the cards' entrance *@
                    <li class="wish-card" style="--i: @i" data-letter-wish>
                        <span class="wish-number" aria-hidden="true">@(i + 1)</span>
                        <div class="wish-body">
                            <p class="wish-name" data-wish-name>@wish.Name</p>
                            @if (Wish.IsWebLink(wish.Link))
                            {
                                <a class="find-it" href="@wish.Link" target="_blank" rel="noopener noreferrer nofollow ugc" data-wish-link>
                                    Find it here<span class="visually-hidden">: @wish.Name</span>
                                    <span class="icon icon-arrow-up-right" aria-hidden="true"></span>
                                </a>
                            }
                            @if (wish.Images.Count > 0)
                            {
                                <div class="wish-pictures">
                                    @foreach (var image in wish.Images)
                                    {
                                        @* Opens in the picture modal; without the page script, in a new tab *@
                                        <a href="/letter/@letter.Id/images/@image" target="_blank" rel="noopener" data-picture>
                                            <img src="/letter/@letter.Id/images/@image" alt="Picture for @wish.Name" loading="lazy" />
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    </li>
                }
            </ol>

            <p class="hand sign-off">With love, @letter.From</p>
        </article>

        @* The example isn't the visitor's own letter, so there is nothing of theirs to share *@
        @if (!Model.IsExample)
        {
            <section class="share" aria-labelledby="share-title">
                <h2 class="heading" id="share-title">Share your letter</h2>
                <p class="body muted">Anyone with this link can read it. It always shows the same letter.</p>
                <div class="share-link">
                    <label class="visually-hidden" for="share-link">Letter link</label>
                    <input class="field" id="share-link" type="text" readonly value="@Model.ShareUrl" />
                    <button type="button" class="btn btn-secondary" id="copy-link">
                        <span class="icon icon-share-link" aria-hidden="true"></span>
                        <span data-label>Copy link</span>
                    </button>
                </div>
                <div class="share-apps">
                    <a class="btn btn-secondary btn-small" href="@whatsApp" target="_blank" rel="noopener">Share on WhatsApp</a>
                    <button type="button" class="btn btn-secondary btn-small" id="native-share" hidden>More ways to share</button>
                </div>
            </section>
        }

        <a class="write-own" href="/write">Write your own letter</a>
    </section>

    @* One modal for every picture on the letter; the page script fills it with the picture clicked.
       No buttons: Escape or a click outside closes it. *@
    <dialog class="modal modal-picture" id="picture-modal" aria-labelledby="picture-title">
        <figure>
            <img data-picture-image alt="" />
            <figcaption>
                <span class="body-strong" id="picture-title" data-picture-title></span>
                <a class="caption" target="_blank" rel="noopener noreferrer nofollow ugc" data-picture-link hidden>Find it here</a>
            </figcaption>
        </figure>
    </dialog>
}
else
{
    <section class="page" data-motion="view">
        <h1 class="title">This letter has been delivered</h1>
        <p class="body">Letters stay for @LetterLimits.RetentionDays days, then Astro carries them to the North Pole for good. This one is already with Santa.</p>
        <a class="btn btn-primary" href="/write">Write a letter</a>
    </section>
}
