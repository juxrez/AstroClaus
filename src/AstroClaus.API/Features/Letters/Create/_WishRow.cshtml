@* Model: (index, wish). The index is "__i__" in the template the page script clones; the script
   numbers the polaroids. *@
@using AstroClaus.API.Features.Letters
@model (string Index, AstroClaus.API.Features.Letters.Create.WishForm Wish)
@{
    var number = int.TryParse(Model.Index, out var index) ? (index + 1).ToString() : "";

    // Errors the server found in this wish (Create.cshtml.cs), shown under their fields. The page
    // script shows the same thing when the letter was sent in the background.
    string FieldName(string field) => $"Form.Wishes[{Model.Index}].{field}";
    string? ErrorFor(string field) =>
        ViewContext.ViewData.ModelState.TryGetValue(FieldName(field), out var entry) && entry.Errors.Count > 0 ? entry.Errors[0].ErrorMessage : null;
    string Invalid(string field) => ErrorFor(field) is null ? "" : "input-validation-error";
    var pictureField = ErrorFor(nameof(Model.Wish.Image1)) is not null ? nameof(Model.Wish.Image1) : nameof(Model.Wish.Image2);
}
@* A wish is a polaroid taped onto the letter, edited right there (design/DESIGN.md §4) *@
<li class="polaroid wish" data-wish>
    <div class="polaroid-front">
        @* The first picture fills the photo; the second is a small polaroid on its corner. Each slot
           holds its thumbnail once a picture is picked, otherwise its add tile: a big empty frame for
           the first, an "Another" chip for the second. Without the page script both tiles show. *@
        <div class="wish-photo" data-error-target>
            @foreach (var field in new[] { nameof(Model.Wish.Image1), nameof(Model.Wish.Image2) })
            {
                var first = field == nameof(Model.Wish.Image1);
                <div class="picture-slot" data-picture-slot>
                    <figure class="thumb" data-thumb hidden>
                        @if (first)
                        {
                            <img alt="" />
                        }
                        else
                        {
                            <button type="button" class="thumb-swap" data-swap-picture aria-label="Show this picture first"><img alt="" /></button>
                        }
                        <button type="button" class="thumb-remove" data-remove-picture aria-label="Remove picture">
                            <span class="icon icon-x" aria-hidden="true"></span>
                        </button>
                    </figure>
                    <label class="add-image">
                        @if (first)
                        {
                            <span class="icon icon-image" aria-hidden="true"></span>
                            <span>Add a picture</span>
                            <span class="add-image-hint">of what you wish for</span>
                        }
                        else
                        {
                            <span class="icon icon-plus" aria-hidden="true"></span>
                            <span>Another</span>
                        }
                        <input class="visually-hidden @Invalid(field)" type="file" name="@FieldName(field)" accept="image/jpeg,image/png,image/webp" data-image />
                    </label>
                </div>
            }
        </div>
        @if (ErrorFor(pictureField) is { } pictureError)
        {
            <span class="field-error field-validation-error" data-valmsg-for="@FieldName(pictureField)">@pictureError</span>
        }

        @* The name wraps like the name on a sent polaroid, but stays one line of text: the page script
           ignores Enter, and the server drops line breaks (LetterText). *@
        <div class="polaroid-caption" data-error-target>
            <span class="wish-number" data-wish-number aria-hidden="true">@number</span>
            <textarea class="wish-name @Invalid("Name")" name="@FieldName("Name")" rows="1" maxlength="@LetterLimits.WishNameMax"
                      placeholder="What are you wishing for?" aria-label="Wish @number" data-wish-name>@Model.Wish.Name</textarea>
        </div>
        @if (ErrorFor("Name") is { } nameError)
        {
            <span class="field-error field-validation-error" data-valmsg-for="@FieldName("Name")">@nameError</span>
        }

        @* The page script folds an empty link field behind its "Shop link" button *@
        <div class="wish-link">
            <button type="button" class="add-link" data-open-link hidden>
                <span class="icon icon-plus" aria-hidden="true"></span>
                Shop link
            </button>
            <input class="wish-link-field @Invalid("Link")" type="url" name="@FieldName("Link")" value="@Model.Wish.Link"
                   maxlength="@LetterLimits.WishLinkMax" placeholder="Shop link (optional): https://…"
                   aria-label="Where to find it (optional link)" autocomplete="off" data-link />
        </div>
        @if (ErrorFor("Link") is { } linkError)
        {
            <span class="field-error field-validation-error" data-valmsg-for="@FieldName("Link")">@linkError</span>
        }
    </div>
    <button type="button" class="wish-remove" data-remove-wish aria-label="Remove wish @number">
        <span class="icon icon-x" aria-hidden="true"></span>
    </button>
</li>
