@page "/write"
@model AstroClaus.API.Features.Letters.Create.CreateModel
@using AstroClaus.API.Features.Letters
@{
    ViewData["Title"] = "Write your letter";
    // Astro sits and waits while the letter is written (design/DESIGN.md §2, rule 2).
    ViewData["Diorama"] = "wait";
}

@section HeaderStart {
    <a class="back-link" href="/">
        <span class="icon icon-arrow-left" aria-hidden="true"></span>
        Back
    </a>
}

@* The header (layout) and the action bar stay put; the middle scrolls between them (design/DESIGN.md §4) *@
<section class="page create-page">
    @* data-astro-watches: typing here makes Astro look up, and keeps him awake (js/diorama) *@
    <form method="post" enctype="multipart/form-data" id="letter-form" class="create-form" data-astro-watches
          data-max-wishes="@LetterLimits.MaxWishes" data-max-images="@LetterLimits.MaxImagesPerWish" data-max-image-bytes="@LetterLimits.MaxImageBytes">
        <div class="create-middle">
            <div class="create-intro">
                <h1 class="title">Write your letter</h1>
                <p class="body muted">Take your time. Astro will wait right here.</p>
            </div>

            <div asp-validation-summary="All" class="banner banner-error body"></div>

            <div class="group nickname">
                <label class="heading" for="from">Your nickname</label>
                <input class="field" id="from" asp-for="Form.From" maxlength="@LetterLimits.FromMax" placeholder="Who is this from?" autocomplete="off" />
            </div>

            <div class="group">
                <label class="heading" for="message">Your message</label>
                @* Written on the letter paper, as it will look once sent. The sign-off fills in with the nickname. *@
                <div class="paper letter-draft">
                    <p class="subtitle">Dear Santa,</p>
                    <textarea class="hand draft-message" id="message" asp-for="Form.Message" rows="4"
                              maxlength="@LetterLimits.MessageMax" placeholder="This year I have been very good..."></textarea>
                    <p class="caption draft-count" aria-live="polite"><span id="message-count">0</span> / @LetterLimits.MessageMax</p>
                    <p class="hand sign-off" aria-hidden="true">With love, <span id="sign-name">@Model.Form.From</span></p>
                </div>
            </div>

            <section class="group" aria-labelledby="wishes-title">
                <div class="wishes-head">
                    <div>
                        <h2 class="heading" id="wishes-title">Your wishes</h2>
                        <p class="body muted">Add a picture of what you're wishing for, up to @LetterLimits.MaxImagesPerWish per wish.</p>
                    </div>
                    <p class="caption muted" aria-live="polite"><span id="wish-count">@Model.Form.Wishes.Count</span> of @LetterLimits.MaxWishes wishes</p>
                </div>

                <ol class="wishes" id="wishes">
                    @for (var i = 0; i < Model.Form.Wishes.Count; i++)
                    {
                        <partial name="_WishRow" model="@((i.ToString(), Model.Form.Wishes[i]))" />
                    }
                </ol>

                <button type="button" class="btn btn-secondary add-wish" id="add-wish">
                    <span class="icon icon-plus" aria-hidden="true"></span>
                    Add a wish
                </button>
                <p class="caption error-text" id="image-error" role="alert" hidden></p>
            </section>
        </div>

        <template id="wish-template">
            <partial name="_WishRow" model="@(("__i__", new WishForm()))" />
        </template>

        <div class="action-bar">
            <p class="info-note">
                <span class="icon icon-sparkle" aria-hidden="true"></span>
                Once it's sent, your letter can't be changed. Give it one last read.
            </p>
            <button type="submit" class="btn btn-primary" id="send">
                <span class="icon icon-send" aria-hidden="true"></span>
                <span data-label>Send to Santa</span>
            </button>
            <p class="caption muted action-terms">By sending, you agree to the <button type="button" class="link" data-open-modal="terms-modal">terms</button>.</p>
        </div>
    </form>
</section>

@* When a letter can't be sent, the page stays as it was and this explains, without the server's
   details (design/DESIGN.md §2, rule 6). To try again, Send to Santa is right there. *@
<dialog class="modal" id="send-failed" aria-labelledby="send-failed-title">
    <div class="modal-body">
        <h2 class="title" id="send-failed-title">Astro couldn't get through</h2>
        <p class="body">We're having trouble delivering your letter. It's safe here, so please try again later.</p>
        <button type="button" class="btn btn-secondary" data-close-modal>Close</button>
    </div>
</dialog>
