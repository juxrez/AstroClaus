@{
    var title = ViewData["Title"] is string t ? $"{t} · Astro Claus" : "Astro Claus";
    var shareTitle = ViewData["ShareTitle"] as string ?? title;
    var description = ViewData["Description"] as string
        ?? "Write a letter to Santa, and Astro the reindeer pup carries it to the North Pole. No account needed.";
    var site = $"{Context.Request.Scheme}://{Context.Request.Host}";
}
<!DOCTYPE html>
@* ViewData["Diorama"]: "delivery" on the page a letter was just sent to, "play" on a letter opened by a reader, "greet" on the landing, "wait" on Create, otherwise the plain scene (design/DESIGN.md §2). *@
<html lang="en" data-diorama="@(ViewData["Diorama"] as string ?? "plain")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>

    @* What search engines and link previews (WhatsApp, Messenger, X...) show. A page may set:
       Description, ShareTitle (the preview's title, if not the page title), Canonical (a path) and
       NoIndex (true keeps the page out of search results: letters). Preview addresses must be absolute. *@
    <meta name="description" content="@description" />
    @if (ViewData["NoIndex"] is true)
    {
        <meta name="robots" content="noindex" />
    }
    @if (ViewData["Canonical"] is string canonical)
    {
        <link rel="canonical" href="@(site + canonical)" />
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Astro Claus" />
    <meta property="og:title" content="@shareTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@(site + Context.Request.Path)" />
    <meta property="og:image" content="@(site + "/share-preview.png")" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Astro, a pixel-art reindeer pup, standing in the snow under the night sky" />
    <meta name="twitter:card" content="summary_large_image" />
    @* Astro's face, cut from his sprite. The 180px one is for phones' home screens. *@
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600&family=Nunito:wght@400;600;700&family=Patrick+Hand&family=Press+Start+2P&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* Before the first paint, decide whether the diorama starts in front of the content: on the first
       page of this tab (rule 5) or right after a letter is sent (rule 6). js/diorama takes over from
       here; if it never does, the content shows anyway (rule 11). *@
    <script>
        (function () {
            var root = document.documentElement;
            var firstArrival = false;
            try {
                firstArrival = !sessionStorage.getItem("diorama:arrived");
                sessionStorage.setItem("diorama:arrived", "1");
            } catch (e) { /* storage unavailable: no opening */ }

            if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
            if (!firstArrival && root.getAttribute("data-diorama") !== "delivery") return;

            root.setAttribute("data-diorama-front", "");
            var fallback = setTimeout(function () { root.removeAttribute("data-diorama-front"); }, 4000);
            document.addEventListener("diorama:control", function () { clearTimeout(fallback); });
        })();
    </script>
    <script type="importmap"></script>
</head>
<body>
    <div class="diorama" aria-hidden="true">
        <canvas id="diorama" width="320" height="180"></canvas>
    </div>

    @* ViewData["SceneWindow"]: on narrow screens, keep the top of the screen clear so Astro shows above
       the panel (design/DESIGN.md §2, rule 13). Hidden on wider screens. *@
    @if (ViewData["SceneWindow"] is true)
    {
        <div class="scene-window" id="scene-window" aria-hidden="true"></div>
    }

    <div class="panel" id="panel">
        @* HeaderStart: an optional link on the left of the wordmark, such as Create's Back link *@
        <header class="site-header">
            @await RenderSectionAsync("HeaderStart", required: false)
            <a class="logo" href="/">ASTRO CLAUS</a>
        </header>

        <main class="site-main">
            @RenderBody()
        </main>

        <footer class="site-footer caption">
            @await RenderSectionAsync("FooterNote", required: false)
            <span class="icon icon-snowflake" aria-hidden="true"></span>
            <button type="button" class="link" data-open-modal="terms-modal">Terms</button>
            @* Ko-fi gets its own line under the rest *@
            <span class="footer-break" aria-hidden="true"></span>
            @* For grown-ups: a link like Terms, with only a small pixel heart. Opens Ko-fi's form in the
               support modal (_SupportModal); without the page script, the Ko-fi page in a new tab. *@
            <a class="support-link" href="https://ko-fi.com/ajuarez" target="_blank" rel="noopener" data-support>
                <svg class="support-heart" viewBox="0 0 9 8" shape-rendering="crispEdges" aria-hidden="true">
                    <path d="M2 1h2v1h1V1h2v1h1v2H7v1H6v1H5v1H4V6H3V5H2V4H1V2h1z" />
                    <path fill="#fff" d="M2 2h1v1H2z" />
                </svg>
                <span>Help keep Astro online</span>
            </a>
        </footer>
    </div>

    @* Shown while a letter is on its way: from Send on Create until Astro has run off on the letter
       page (design/DESIGN.md §2, rule 6). Hidden everywhere else by site.css. *@
    <div class="sending-card" role="status">
        <p>
            <span class="icon icon-envelope" aria-hidden="true"></span>
            <span>Astro is taking your letter to the North Pole<span class="sending-dots" aria-hidden="true"><span>.</span><span>.</span><span>.</span></span></span>
        </p>
    </div>

    <partial name="_TermsModal" />
    <partial name="_SupportModal" />

    @* One entry point for scripts. *@
    <script type="module" src="~/js/app.js" asp-append-version="true"></script>
</body>
</html>
