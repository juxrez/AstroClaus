@* Model: "front" or "side" (both are pictures with a room behind him) or "alone" (side view, cut out, nothing behind him). One Astro per screen. *@
@model string
@{
    var file = Model switch { "side" => "Astro_Side", "alone" => "astro_side_alone", _ => "Astro_front" };
}
<img class="astro astro-@Model"
     data-motion="astro"
     src="~/assets/@(file).svg"
     alt="Astro, a small Shih Tzu reindeer"
     width="260" height="260" />
