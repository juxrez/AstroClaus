@* The terms, on every page. Any button with data-open-modal="terms-modal" opens it. *@
@using AstroClaus.API.Features.Letters
<dialog class="modal modal-terms" id="terms-modal" aria-labelledby="terms-title">
    <div class="modal-body">
        <h2 class="title" id="terms-title">@T["Before you write"]</h2>

        <div class="modal-middle">
            <h3 class="heading">@T["Keep it to wishes"]</h3>
            <p class="body">@T["Please don't put personal information in a letter: no full names, addresses, phone numbers, school names or photos of people. A nickname and a wish list are all Santa needs."]</p>

            <h3 class="heading">@T["Anyone with the link can read it"]</h3>
            <p class="body">@T["There are no accounts. A letter is private only as long as its link is. Share it with people you trust."]</p>

            <h3 class="heading">@T["Letters can't be edited"]</h3>
            <p class="body">@T["Once a letter is sent, it can't be changed. It can be deleted, but only from the browser it was sent from: open the letter there and choose Delete my letter."]</p>

            <h3 class="heading">@T["Letters stay for {0} days", LetterLimits.RetentionDays]</h3>
            <p class="body">@T["After {0} days, Astro carries the letter to the North Pole for good, and its link stops working.", LetterLimits.RetentionDays]</p>

            <h3 class="heading">@T["What we keep in your browser"]</h3>
            <p class="body">@T["Two small things: your language, if you pick one, and a key for each letter you send, so you can delete it later. Nothing is used to track you."]</p>
        </div>

        <button type="button" class="btn btn-secondary" data-close-modal>@T["Close"]</button>
    </div>
</dialog>
